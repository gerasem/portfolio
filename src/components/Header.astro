---
import { type Locale, PROFILE, UI_COPY } from '../data/portfolioData';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = UI_COPY[locale].nav;

const navItems = [
  { href: '#pipeline', label: copy.pipeline },
  { href: '#projects', label: copy.projects },
  { href: '#timeline', label: copy.timeline },
  { href: '#services', label: copy.services },
  { href: '#works', label: copy.works },
];
---

<header class="sticky top-0 z-40 border-b border-slate-200/60 bg-[#F6F8FC]/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-[1450px] items-center justify-between gap-8 px-6 py-3.5">
    <!-- Zone 1: Single-line Brand Wordmark -->
    <a
      href="#top"
      class="font-display text-base font-semibold tracking-tight text-slate-800 whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
    >
      {PROFILE.name}
    </a>

    <!-- Zone 2: Concise single-line text links -->
    <nav
      aria-label={locale === 'de' ? 'Hauptnavigation' : 'Main navigation'}
      class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-500"
    >
      {navItems.map((item) => (
        <a
          href={item.href}
          class="whitespace-nowrap shrink-0 py-1 transition-colors duration-150 hover:text-slate-800 hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Zone 3: 1 gentle shadowed CTA -->
    <div class="flex items-center gap-3 shrink-0">
      <button
        type="button"
        data-open-contact
        class="inline-flex items-center justify-center rounded-2xl bg-[#3B82F6] px-4 py-2 text-xs font-semibold text-white shadow-[0_6px_16px_-4px_rgba(59,130,246,0.4)] transition-all duration-200 hover:bg-[#2563EB] hover:shadow-[0_8px_20px_-4px_rgba(59,130,246,0.5)] active:scale-[0.98] whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
      >
        {copy.contactCta}
      </button>
    </div>
  </div>
</header>
