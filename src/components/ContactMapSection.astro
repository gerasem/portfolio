---
import { Mail } from 'lucide-react';
import { type Locale, PROFILE, UI_COPY } from '../data/portfolioData';
import RegionMap from './RegionMap.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = UI_COPY[locale].services;
---

<section id="contact" aria-labelledby="contact-heading" class="scroll-mt-16 pt-2 pb-16">
  <div class="mx-auto max-w-[1450px] px-6">
    <div
      data-reveal
      data-reveal-delay="50"
      class="grid grid-cols-1 items-stretch gap-6 rounded-3xl border border-slate-200/70 bg-gradient-to-br from-white via-white to-blue-50/40 p-6 shadow-[0_10px_32px_-12px_rgba(30,41,59,0.08)] sm:p-7 lg:grid-cols-12"
    >
      <div class="flex flex-col justify-between gap-5 lg:col-span-7">
        <div>
          <h2 id="contact-heading" class="font-display text-base font-semibold tracking-tight text-slate-900 sm:text-lg">
            {copy.ctaHeading}
          </h2>
          <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{copy.ctaSubtext}</p>
          <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-medium text-slate-500">
            <span>{PROFILE.location[locale]}</span>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <button
            type="button"
            data-open-contact
            class="inline-flex items-center gap-2 rounded-2xl bg-[#3B82F6] px-5 py-2.5 text-xs font-semibold text-white shadow-[0_8px_20px_-4px_rgba(59,130,246,0.45)] transition-all duration-200 hover:bg-[#2563EB] hover:shadow-[0_10px_24px_-4px_rgba(59,130,246,0.55)] active:scale-[0.98] whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
          >
            <Mail className="h-3.5 w-3.5" />
            <span>{copy.contactButton}</span>
          </button>
        </div>
      </div>

      <div class="lg:col-span-5">
        <RegionMap locale={locale} />
      </div>
    </div>
  </div>
</section>
