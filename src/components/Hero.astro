---
import {
  Github,
  Linkedin,
} from 'lucide-react';
import { type Locale, PROFILE, UI_COPY } from '../data/portfolioData';
import { DevProcessInstallation } from './DevProcessInstallation';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = UI_COPY[locale];

const mailtoSubject = encodeURIComponent(
  locale === 'de'
    ? 'Bewerbung / Projektanfrage an Dmitri Laptev'
    : 'Application / Project Inquiry for Dmitri Laptev'
);
---

<section class="pt-4 pb-10 sm:pt-6 sm:pb-12">
  <div class="mx-auto max-w-[1450px] px-6">
    <!-- Compact Hero Utility Row: Language Switcher -->
    <div class="mb-4 sm:mb-5 flex flex-wrap items-center justify-end gap-3">
      <div
        role="group"
        aria-label="Language switcher"
        class="inline-flex items-center gap-1 rounded-2xl border border-slate-200/75 bg-white/85 p-1 shadow-xs backdrop-blur-xs"
      >
        <a
          href="/"
          aria-current={locale === 'de' ? 'page' : undefined}
          class={`rounded-xl px-3 py-1 text-xs font-semibold transition-all duration-150 focus-visible:outline-2 focus-visible:outline-blue-500 ${
            locale === 'de'
              ? 'bg-[#3B82F6] text-white shadow-xs shadow-blue-500/30'
              : 'text-slate-500 hover:text-slate-800'
          }`}
        >
          DE
        </a>
        <a
          href="/en/"
          aria-current={locale === 'en' ? 'page' : undefined}
          class={`rounded-xl px-3 py-1 text-xs font-semibold transition-all duration-150 focus-visible:outline-2 focus-visible:outline-blue-500 ${
            locale === 'en'
              ? 'bg-[#3B82F6] text-white shadow-xs shadow-blue-500/30'
              : 'text-slate-500 hover:text-slate-800'
          }`}
        >
          EN
        </a>
      </div>
    </div>

    <!-- 2-Column Split: Open Airy Left Intro | Elevated Soft Right Installation -->
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[5fr_8fr]">
      <div class="flex flex-col justify-center">
        <p class="text-xs font-semibold tracking-wide text-blue-600">
          {copy.hero.kicker}
        </p>

        <h1
          class="mt-3 font-display font-semibold tracking-tight text-slate-900"
          style="font-size: clamp(1.75rem, 2.75vw, 2.35rem); line-height: 1.18; text-wrap: balance;"
        >
          {copy.hero.headline}
        </h1>

        <p class="mt-4 text-[0.9375rem] leading-relaxed text-slate-600">
          {copy.hero.lead}
        </p>

        <!-- Soft GitHub & LinkedIn Profile Links -->
        <div class="mt-6 flex flex-wrap items-center gap-2.5 border-t border-slate-200/70 pt-5 text-[0.65rem]">
          <a
            href={PROFILE.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-xl bg-white/80 px-2.5 py-1.5 font-medium text-slate-700 shadow-2xs ring-1 ring-slate-200/70 transition-all hover:bg-white hover:text-blue-600 hover:shadow-xs whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-blue-500"
          >
            <Github className="h-3.5 w-3.5 text-slate-600" />
            <span>{PROFILE.githubHandle}</span>
          </a>

          <a
            href={PROFILE.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-xl bg-white/80 px-2.5 py-1.5 font-medium text-slate-700 shadow-2xs ring-1 ring-slate-200/70 transition-all hover:bg-white hover:text-blue-600 hover:shadow-xs whitespace-nowrap shrink-0 focus-visible:outline-2 focus-visible:outline-blue-500"
          >
            <Linkedin className="h-3.5 w-3.5 text-[#0A66C2]" />
            <span>{PROFILE.linkedinHandle}</span>
          </a>
        </div>
      </div>

      <div>
        <DevProcessInstallation locale={locale} client:idle />
      </div>
    </div>

    <!-- Full-Width 5-Column Capability Strip Below Hero Split -->
    <div class="mt-8 grid grid-cols-2 gap-3.5 lg:grid-cols-5">
      {copy.metricsStrip.map((metric, idx) => (
        <div
          data-reveal
          data-reveal-delay={idx * 60}
          class="rounded-2xl border border-slate-200/60 bg-white/85 px-5 py-4 shadow-[0_6px_20px_-6px_rgba(30,41,59,0.06)] backdrop-blur-xs"
        >
          <div class="font-display text-sm font-semibold tabular-nums text-slate-800">
            {metric.value}
          </div>
          <div class="mt-0.5 text-xs text-slate-500">{metric.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
