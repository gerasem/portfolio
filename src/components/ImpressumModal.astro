---
import { X } from 'lucide-react';
import type { Locale } from '../data/portfolioData';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isDe = locale === 'de';
---

<div
  id="impressum-modal"
  data-nosnippet
  role="dialog"
  aria-modal="true"
  aria-label="Impressum"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/45 p-4 backdrop-blur-xs"
>
  <div
    data-impressum-panel
    class="relative max-h-[88vh] w-full max-w-xl overflow-y-auto rounded-3xl border border-slate-200/80 bg-white p-6 shadow-[0_24px_60px_-15px_rgba(15,23,42,0.25)] sm:p-7"
  >
    <div class="flex items-center justify-between gap-4 border-b border-slate-100 pb-4">
      <h2 class="font-display text-base font-semibold tracking-tight text-slate-900">
        Impressum
      </h2>
      <button
        type="button"
        data-close-impressum
        aria-label={isDe ? 'Schließen' : 'Close'}
        class="inline-flex h-8 w-8 items-center justify-center rounded-xl border border-slate-200/80 bg-white text-slate-500 transition-colors hover:bg-slate-50 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-blue-500"
      >
        <X className="h-4 w-4" />
      </button>
    </div>

    <div class="mt-5 space-y-5 text-xs leading-relaxed text-slate-600 select-text">
      <section class="space-y-1.5">
        <h3 class="font-display text-xs font-semibold text-slate-800">
          {isDe
            ? 'Angaben gemäß § 5 DDG (Digitale-Dienste-Gesetz)'
            : 'Information pursuant to § 5 DDG (German Digital Services Act)'}
        </h3>
        <address class="not-italic text-slate-600 space-y-0.5">
          <div class="font-medium text-slate-800">
            <span data-pii="name" aria-busy="true" class="inline-block rounded bg-slate-200/70 text-transparent animate-pulse select-none">••••••••••</span>
          </div>
          <div>
            <span data-pii="street" aria-busy="true" class="inline-block rounded bg-slate-200/70 text-transparent animate-pulse select-none">••••••••••</span>
          </div>
          <div>
            <span data-pii="city" aria-busy="true" class="inline-block rounded bg-slate-200/70 text-transparent animate-pulse select-none">••••••••••</span>
          </div>
          <div>{isDe ? 'Deutschland' : 'Germany'}</div>
        </address>
      </section>

      <section class="space-y-1.5">
        <h3 class="font-display text-xs font-semibold text-slate-800">
          {isDe ? 'Kontakt' : 'Contact'}
        </h3>
        <div class="space-y-0.5">
          <div>
            <span class="font-medium text-slate-700">{isDe ? 'Telefon:' : 'Phone:'}</span>{' '}
            <span data-pii="phone" aria-busy="true" class="inline-block rounded bg-slate-200/70 text-transparent animate-pulse select-none">••••••••••</span>
          </div>
          <div>
            <span class="font-medium text-slate-700">E-Mail:</span>{' '}
            <span data-pii="email" aria-busy="true" class="inline-block rounded bg-slate-200/70 text-transparent animate-pulse select-none">••••••••••</span>
          </div>
        </div>
      </section>

      <section class="space-y-1.5">
        <h3 class="font-display text-xs font-semibold text-slate-800">
          {isDe
            ? 'Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV'
            : 'Responsible for content pursuant to § 18 (2) MStV'}
        </h3>
        <address class="not-italic text-slate-600 space-y-0.5">
          <div class="font-medium text-slate-800">
            <span data-pii="name" aria-busy="true" class="inline-block rounded bg-slate-200/70 text-transparent animate-pulse select-none">••••••••••</span>
          </div>
          <div>
            <span data-pii="street" aria-busy="true" class="inline-block rounded bg-slate-200/70 text-transparent animate-pulse select-none">••••••••••</span>
          </div>
          <div>
            <span data-pii="city" aria-busy="true" class="inline-block rounded bg-slate-200/70 text-transparent animate-pulse select-none">••••••••••</span>
          </div>
        </address>
      </section>

      <section class="space-y-1.5">
        <h3 class="font-display text-xs font-semibold text-slate-800">
          {isDe
            ? 'Verbraucherstreitbeilegung / Universalschlichtungsstelle (§ 36 VSBG)'
            : 'Consumer Dispute Resolution (§ 36 VSBG)'}
        </h3>
        <p>
          {isDe
            ? 'Wir sind nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.'
            : 'We are neither willing nor obliged to participate in dispute resolution proceedings before a consumer arbitration board.'}
        </p>
      </section>

      <section class="space-y-1.5">
        <h3 class="font-display text-xs font-semibold text-slate-800">
          {isDe ? 'Haftung für Inhalte & Links' : 'Liability for Content & Links'}
        </h3>
        <p>
          {isDe
            ? 'Die Inhalte dieser Website wurden mit größter Sorgfalt erstellt. Für die Richtigkeit, Vollständigkeit und Aktualität der Inhalte können wir jedoch keine Gewähr übernehmen. Bei Bekanntwerden von Rechtsverletzungen werden entsprechende Inhalte oder Verlinkungen umgehend entfernt.'
            : 'The contents of this website were created with the utmost care. However, no guarantee can be given for the accuracy, completeness, or topicality of the content. Upon notification of any legal infringements, such content or external links will be removed immediately.'}
        </p>
      </section>
    </div>
  </div>
</div>

<script>
  import { bindPiiModal } from '../utils/piiReveal';
  bindPiiModal(
    'impressum-modal',
    '[data-open-impressum]',
    '[data-close-impressum]',
    '[data-impressum-panel]'
  );
</script>
