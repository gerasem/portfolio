---
import {
  AppWindow,
  LayoutTemplate,
  ShoppingBag,
} from 'lucide-react';
import { type Locale, SERVICES, UI_COPY } from '../data/portfolioData';
import { TechIcon } from './TechIcon';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = UI_COPY[locale].services;

const SERVICE_ICONS = [LayoutTemplate, ShoppingBag, AppWindow];
---

<section id="services" class="scroll-mt-16 py-12">
  <div class="mx-auto max-w-[1450px] px-6">
    <div data-reveal class="max-w-2xl">
      <h2 class="font-display text-xl font-semibold tracking-tight text-slate-900 sm:text-2xl">
        {copy.title}
      </h2>
      <p class="mt-1.5 text-sm leading-relaxed text-slate-500">
        {copy.subtitle}
      </p>
    </div>

    <!-- 3 Gentle Rounded Service Cards (No prices) -->
    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
      {SERVICES.map((service, idx) => {
        const Icon = SERVICE_ICONS[idx] ?? LayoutTemplate;
        const stackItems = service.typicalStack.split(' · ');

        return (
          <div
            data-reveal
            data-reveal-delay={idx * 80}
            class="flex flex-col justify-between rounded-3xl border border-slate-200/65 bg-white/95 p-6 shadow-[0_8px_28px_-10px_rgba(30,41,59,0.06)] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_14px_32px_-10px_rgba(30,41,59,0.1)]"
          >
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-blue-50/90 text-blue-600 shadow-2xs">
                  <Icon className="h-5 w-5" />
                </span>
                <span class="text-xs font-semibold tabular-nums text-slate-300">
                  {service.index}
                </span>
              </div>

              <h3 class="mt-4 font-display text-base font-semibold tracking-tight text-slate-900">
                {service.title[locale]}
              </h3>
              <p class="mt-2 text-[0.84375rem] leading-relaxed text-slate-600">
                {service.summary[locale]}
              </p>

              <div class="mt-4 border-t border-slate-100 pt-3.5">
                <div class="text-xs font-medium text-slate-400">
                  {copy.deliverablesLabel}
                </div>
                <ul class="mt-2 space-y-2">
                  {service.deliverables[locale].map((item) => (
                    <li class="flex items-start gap-2 text-xs leading-relaxed text-slate-600">
                      <span
                        aria-hidden="true"
                        class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-400"
                      />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1.5 border-t border-slate-100 pt-3.5">
              {stackItems.map((tech) => (
                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500">
                  <TechIcon name={tech} className="h-3.5 w-3.5 shrink-0" />
                  <span>{tech}</span>
                </span>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
