---
import { X } from 'lucide-react';
import type { Locale } from '../data/portfolioData';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  id="datenschutz-modal"
  data-nosnippet
  data-locale={locale}
  role="dialog"
  aria-modal="true"
  aria-label={locale === 'de' ? 'Datenschutzerklärung' : 'Privacy Policy'}
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/45 p-4 backdrop-blur-xs"
>
  <div
    data-datenschutz-panel
    class="relative max-h-[88vh] w-full max-w-2xl overflow-y-auto rounded-3xl border border-slate-200/80 bg-white p-6 shadow-[0_24px_60px_-15px_rgba(15,23,42,0.25)] sm:p-7"
  >
    <div class="flex items-center justify-between gap-4 border-b border-slate-100 pb-4">
      <div class="font-display text-base font-semibold tracking-tight text-slate-900">
        {locale === 'de' ? 'Datenschutzerklärung' : 'Privacy Policy'}
      </div>
      <button
        type="button"
        data-close-datenschutz
        aria-label={locale === 'de' ? 'Schließen' : 'Close'}
        class="inline-flex h-8 w-8 items-center justify-center rounded-xl border border-slate-200/80 bg-white text-slate-500 transition-colors hover:bg-slate-50 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-blue-500"
      >
        <X className="h-4 w-4" />
      </button>
    </div>

    <!-- Dynamically populated non-semantic container (cleared on close) -->
    <div id="datenschutz-body" class="mt-5 space-y-5 text-xs leading-relaxed text-slate-600"></div>
  </div>
</div>

<script>
  const modal = document.getElementById('datenschutz-modal') as HTMLElement | null;
  const panel = modal?.querySelector('[data-datenschutz-panel]') as HTMLElement | null;
  const bodyEl = document.getElementById('datenschutz-body');
  const closeBtn = modal?.querySelector('[data-close-datenschutz]') as HTMLButtonElement | null;
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-open-datenschutz]');

  const PAYLOAD = {
    name: [30, 55, 51, 46, 40, 51, 122, 22, 59, 42, 46, 63, 44],
    street: [21, 56, 63, 40, 63, 122, 28, 63, 54, 62, 41, 46, 40, 116, 122, 108],
    city: [98, 105, 105, 99, 111, 122, 28, 40, 63, 51, 54, 59, 41, 41, 51, 52, 61],
    countryDe: [30, 63, 47, 46, 41, 57, 50, 54, 59, 52, 62],
    countryEn: [29, 63, 40, 55, 59, 52, 35],
    email: [62, 98, 105, 105, 99, 111, 26, 61, 55, 59, 51, 54, 116, 57, 53, 55],
    phone: [113, 110, 99, 122, 107, 111, 108, 109, 98, 122, 99, 108, 98, 107, 105, 105],
  };

  const DECOY_TOKENS = ['x9', '@n', '0z', 'k#', '7q', 'v_', '4m'];

  const decodeBytes = (bytes: number[]): string =>
    new TextDecoder().decode(new Uint8Array(bytes.map((b) => b ^ 0x5a)));

  const createNoiseSpan = (): HTMLSpanElement => {
    const decoy = document.createElement('span');
    decoy.setAttribute('aria-hidden', 'true');
    decoy.textContent = DECOY_TOKENS[Math.floor(Math.random() * DECOY_TOKENS.length)];
    decoy.style.cssText =
      'position:absolute;width:0;height:0;overflow:hidden;opacity:0;pointer-events:none;user-select:none;';
    return decoy;
  };

  const createScrambledLine = (bytes: number[], extraClass = ''): HTMLDivElement => {
    const text = decodeBytes(bytes);
    const wrap = document.createElement('div');
    wrap.className = `relative inline-flex flex-wrap items-baseline ${extraClass}`.trim();

    const chunks: { part: string; order: number }[] = [];
    for (let i = 0; i < text.length; i += 2) {
      chunks.push({ part: text.slice(i, i + 2), order: i });
    }

    for (let i = chunks.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [chunks[i], chunks[j]] = [chunks[j], chunks[i]];
    }

    chunks.forEach((chunk, idx) => {
      if (idx % 2 === 1) {
        wrap.appendChild(createNoiseSpan());
      }
      const span = document.createElement('span');
      span.textContent = chunk.part;
      span.style.order = String(chunk.order);
      span.style.whiteSpace = 'pre';
      wrap.appendChild(span);
    });

    return wrap;
  };

  const createSection = (title: string, children: HTMLElement[]): HTMLDivElement => {
    const block = document.createElement('div');
    block.className = 'space-y-1.5';

    const heading = document.createElement('div');
    heading.className = 'font-display text-xs font-semibold text-slate-800';
    heading.textContent = title;
    block.appendChild(heading);

    children.forEach((child) => block.appendChild(child));
    return block;
  };

  const createNote = (text: string): HTMLDivElement => {
    const div = document.createElement('div');
    div.className = 'text-slate-600';
    div.textContent = text;
    return div;
  };

  const createLabeledRow = (label: string, bytes: number[]): HTMLDivElement => {
    const row = document.createElement('div');
    row.className = 'flex flex-wrap items-baseline gap-1.5';

    const lbl = document.createElement('span');
    lbl.className = 'font-medium text-slate-700';
    lbl.textContent = label;

    row.appendChild(lbl);
    row.appendChild(createScrambledLine(bytes, 'text-slate-600'));
    return row;
  };

  const renderDatenschutzBody = () => {
    if (!bodyEl || !modal) return;
    const isDe = modal.dataset.locale !== 'en';
    bodyEl.replaceChildren();

    const controllerBox = document.createElement('div');
    controllerBox.className = 'flex flex-col gap-0.5 text-slate-600';
    controllerBox.appendChild(createScrambledLine(PAYLOAD.name, 'font-medium text-slate-800'));
    controllerBox.appendChild(createScrambledLine(PAYLOAD.street));
    controllerBox.appendChild(createScrambledLine(PAYLOAD.city));
    controllerBox.appendChild(
      createScrambledLine(isDe ? PAYLOAD.countryDe : PAYLOAD.countryEn)
    );

    if (isDe) {
      bodyEl.appendChild(
        createSection('1. Verantwortliche Stelle (Art. 13 Abs. 1 lit. a DSGVO)', [
          createNote(
            'Verantwortlich für die Datenverarbeitung auf dieser Website im Sinne der Datenschutz-Grundverordnung (DSGVO) ist:'
          ),
          controllerBox,
          createLabeledRow('Telefon:', PAYLOAD.phone),
          createLabeledRow('E-Mail:', PAYLOAD.email),
        ])
      );

      bodyEl.appendChild(
        createSection('2. Hosting über GitHub Pages & Server-Logfiles', [
          createNote(
            'Diese statische Website wird über den Dienst GitHub Pages der GitHub, Inc., 88 Colin P Kelly Jr St, San Francisco, CA 94107, USA (bzw. GitHub B.V., Prins Bernhardplein 200, Amsterdam, Niederlande für den EWR) bereitgestellt.'
          ),
          createNote(
            'Beim Aufruf der Website erfasst der Hosting-Anbieter technisch bedingt Zugriffsdaten in Server-Logfiles (z. B. IP-Adresse, Datum und Uhrzeit des Zugriffs, aufgerufene Seite, Browsertyp, Betriebssystem sowie Referrer-URL). Die Verarbeitung erfolgt auf Grundlage von Art. 6 Abs. 1 lit. f DSGVO (berechtigtes Interesse an einer sicheren, stabilen und effizienten Bereitstellung der Website).'
          ),
          createNote(
            'Da GitHub ein US-amerikanisches Unternehmen ist, kann eine Datenübermittlung in die USA erfolgen. Diese stützt sich auf das EU-US Data Privacy Framework (DPF) sowie auf Standardvertragsklauseln (SCC) der EU-Kommission. Weitere Informationen finden Sie im GitHub Privacy Statement: https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement'
          ),
        ])
      );

      bodyEl.appendChild(
        createSection('3. Cookies, Tracking & lokale Schriftarten', [
          createNote(
            'Diese Website verwendet keine Cookies, keine Analyse- oder Tracking-Tools (z. B. kein Google Analytics) und keine externen Schriftarten-Dienste. Alle verwendeten Schriftarten (DM Sans, Plus Jakarta Sans) werden lokal vom eigenen Webserver ausgeliefert.'
          ),
        ])
      );

      bodyEl.appendChild(
        createSection('4. Kontaktaufnahme per E-Mail', [
          createNote(
            'Wenn Sie per E-Mail Kontakt aufnehmen, werden Ihre übermittelten Angaben (E-Mail-Adresse, Name, Nachrichteninhalt) ausschließlich zur Bearbeitung Ihrer Anfrage gespeichert. Rechtsgrundlage ist Art. 6 Abs. 1 lit. b DSGVO (vorvertragliche/vertragliche Maßnahmen) bzw. Art. 6 Abs. 1 lit. f DSGVO (berechtigtes Interesse an der Beantwortung von Anfragen). Die Daten werden gelöscht, sobald sie für die Erreichung des Zweckes nicht mehr erforderlich sind und keine gesetzlichen Aufbewahrungspflichten entgegenstehen.'
          ),
        ])
      );

      bodyEl.appendChild(
        createSection('5. Externe Links (GitHub, LinkedIn, Google Maps)', [
          createNote(
            'Diese Website enthält reine Verlinkungen zu externen Plattformen (GitHub, LinkedIn, Google Maps). Es sind keine externen iFrames oder Tracking-Skripte eingebettet. Erst wenn Sie aktiv auf einen entsprechenden Link klicken, werden Daten an den jeweiligen Drittanbieter übertragen.'
          ),
        ])
      );

      bodyEl.appendChild(
        createSection('6. SSL- bzw. TLS-Verschlüsselung', [
          createNote(
            'Diese Seite nutzt aus Sicherheitsgründen und zum Schutz der Übertragung vertraulicher Inhalte eine SSL- bzw. TLS-Verschlüsselung (HTTPS).'
          ),
        ])
      );

      bodyEl.appendChild(
        createSection('7. Ihre Rechte als betroffene Person (Art. 15–21, 77 DSGVO)', [
          createNote(
            'Sie haben im Rahmen der geltenden gesetzlichen Bestimmungen jederzeit das Recht auf Auskunft über Ihre gespeicherten personenbezogenen Daten (Art. 15 DSGVO), Berichtigung (Art. 16 DSGVO), Löschung (Art. 17 DSGVO), Einschränkung der Verarbeitung (Art. 18 DSGVO), Datenübertragbarkeit (Art. 20 DSGVO) sowie Widerspruch gegen die Verarbeitung (Art. 21 DSGVO).'
          ),
          createNote(
            'Zudem steht Ihnen gemäß Art. 77 DSGVO ein Beschwerderecht bei einer Datenschutz-Aufsichtsbehörde zu. Zuständige Aufsichtsbehörde in Bayern ist: Bayerisches Landesamt für Datenschutzaufsicht (BayLDA), Promenade 18, 91522 Ansbach, Deutschland.'
          ),
        ])
      );
    } else {
      bodyEl.appendChild(
        createSection('1. Data Controller (Art. 13(1)(a) GDPR)', [
          createNote(
            'The controller responsible for data processing on this website within the meaning of the General Data Protection Regulation (GDPR) is:'
          ),
          controllerBox,
          createLabeledRow('Phone:', PAYLOAD.phone),
          createLabeledRow('Email:', PAYLOAD.email),
        ])
      );

      bodyEl.appendChild(
        createSection('2. Hosting via GitHub Pages & Server Log Files', [
          createNote(
            'This static website is hosted on GitHub Pages, provided by GitHub, Inc., 88 Colin P Kelly Jr St, San Francisco, CA 94107, USA (and GitHub B.V., Prins Bernhardplein 200, Amsterdam, Netherlands for the EEA).'
          ),
          createNote(
            'When you access this website, the hosting provider technically collects access data in server log files (e.g. IP address, date and time of access, requested page, browser type, operating system, and referrer URL). Processing is based on Art. 6(1)(f) GDPR (legitimate interest in a reliable, secure, and efficient provision of the website).'
          ),
          createNote(
            'As GitHub is a US-based company, data may be transferred to the United States. Such transfers are based on the EU-US Data Privacy Framework (DPF) and European Commission Standard Contractual Clauses (SCC). Further details can be found in the GitHub Privacy Statement: https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement'
          ),
        ])
      );

      bodyEl.appendChild(
        createSection('3. No Cookies, No Tracking & Local Fonts', [
          createNote(
            'This website does not use cookies, analytics or tracking tools (e.g. no Google Analytics), and no external font CDNs. All fonts (DM Sans, Plus Jakarta Sans) are self-hosted and served locally.'
          ),
        ])
      );

      bodyEl.appendChild(
        createSection('4. Contact via Email', [
          createNote(
            'If you contact me via email, the information you provide (email address, name, message content) will be stored solely to process your inquiry pursuant to Art. 6(1)(b) GDPR (pre-contractual/contractual steps) or Art. 6(1)(f) GDPR (legitimate interest in responding to inquiries). Data is deleted once it is no longer required and no statutory retention obligations apply.'
          ),
        ])
      );

      bodyEl.appendChild(
        createSection('5. External Links (GitHub, LinkedIn, Google Maps)', [
          createNote(
            'This website contains plain links to external platforms (GitHub, LinkedIn, Google Maps). No external iframes or tracking scripts are embedded. Data is only transmitted to third-party providers if you actively click one of those links.'
          ),
        ])
      );

      bodyEl.appendChild(
        createSection('6. SSL / TLS Encryption', [
          createNote(
            'For security reasons and to protect the transmission of data, this site uses SSL / TLS encryption (HTTPS).'
          ),
        ])
      );

      bodyEl.appendChild(
        createSection('7. Your Rights under GDPR (Art. 15–21, 77 GDPR)', [
          createNote(
            'You have the right to request access to your personal data (Art. 15 GDPR), rectification (Art. 16 GDPR), erasure (Art. 17 GDPR), restriction of processing (Art. 18 GDPR), data portability (Art. 20 GDPR), and to object to processing (Art. 21 GDPR).'
          ),
          createNote(
            'You also have the right to lodge a complaint with a supervisory authority pursuant to Art. 77 GDPR. The competent supervisory authority in Bavaria is: Bayerisches Landesamt für Datenschutzaufsicht (BayLDA), Promenade 18, 91522 Ansbach, Germany.'
          ),
        ])
      );
    }
  };

  const openModal = () => {
    if (!modal) return;
    renderDatenschutzBody();
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  };

  const closeModal = () => {
    if (!modal || !bodyEl) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    bodyEl.replaceChildren();
    document.body.style.overflow = '';
  };

  triggers.forEach((btn) => btn.addEventListener('click', openModal));
  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) closeModal();
  });
  panel?.addEventListener('click', (event) => event.stopPropagation());
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
