---
import '../index.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'de' | 'en';
}

const {
  title = 'Dmitri Laptev — Frontend & Full-Stack Developer',
  description = 'Portfolio & Projektübersicht von Dmitri Laptev: Vue/Nuxt, TypeScript, Payload CMS, Astro, React und KI-gestützte Webentwicklung.',
  lang = 'de',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#F6F8FC] text-[#1E293B] antialiased selection:bg-[#3B82F6]/15 selection:text-[#1E293B]">
    <slot />
  </body>
</html>
