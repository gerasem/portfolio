---
import '../index.css';
import type { Locale } from '../data/portfolioData';

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
}

const {
  lang = 'de',
  title = lang === 'de'
    ? 'Dmitri Laptev — Frontend & Full-Stack Developer'
    : 'Dmitri Laptev — Frontend & Full-Stack Developer',
  description = lang === 'de'
    ? 'Portfolio & Projektübersicht von Dmitri Laptev: Vue/Nuxt, TypeScript, Payload CMS, Astro, React und KI-gestützte Webentwicklung.'
    : 'Portfolio & project overview of Dmitri Laptev: Vue/Nuxt, TypeScript, Payload CMS, Astro, React and AI-assisted web development.',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="de" href="/" />
    <link rel="alternate" hreflang="en" href="/en/" />
  </head>
  <body class="bg-[#F6F8FC] text-[#1E293B] antialiased selection:bg-[#3B82F6]/15 selection:text-[#1E293B]">
    <slot />

    <script>
      // Scroll reveal observer
      const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && revealEls.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const delay = el.dataset.revealDelay;
                if (delay) {
                  el.style.transitionDelay = `${delay}ms`;
                }
                el.dataset.reveal = 'visible';
                observer.unobserve(el);
              }
            }
          },
          { threshold: 0.12 }
        );
        revealEls.forEach((el) => observer.observe(el));
      } else {
        revealEls.forEach((el) => {
          el.dataset.reveal = 'visible';
        });
      }

      // Copy email buttons
      document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const email = btn.dataset.copyEmail;
          if (!email) return;
          try {
            await navigator.clipboard.writeText(email);
            const defaultLabel = btn.querySelector<HTMLElement>('[data-copy-default]');
            const copiedLabel = btn.querySelector<HTMLElement>('[data-copy-success]');
            if (defaultLabel && copiedLabel) {
              defaultLabel.classList.add('hidden');
              copiedLabel.classList.remove('hidden');
              window.setTimeout(() => {
                defaultLabel.classList.remove('hidden');
                copiedLabel.classList.add('hidden');
              }, 2000);
            }
          } catch {
            // Clipboard write may be blocked in restricted contexts
          }
        });
      });
    </script>
  </body>
</html>
