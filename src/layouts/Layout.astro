---
import '../index.css';
import dmSansUrl from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import plusJakartaUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import type { Locale } from '../data/portfolioData';

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
}

const {
  lang = 'de',
  title = lang === 'de'
    ? 'Dmitri Laptev — Frontend & Full-Stack Developer'
    : 'Dmitri Laptev — Frontend & Full-Stack Developer',
  description = lang === 'de'
    ? 'Portfolio & Projektübersicht von Dmitri Laptev: Vue/Nuxt, TypeScript, Payload CMS, Astro, React und KI-gestützte Webentwicklung.'
    : 'Portfolio & project overview of Dmitri Laptev: Vue/Nuxt, TypeScript, Payload CMS, Astro, React and AI-assisted web development.',
} = Astro.props;

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const deUrl = Astro.site ? new URL('/', Astro.site).toString() : '/';
const enUrl = Astro.site ? new URL('/en/', Astro.site).toString() : '/en/';
const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://dlaptev.de';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteOrigin}/#person`,
      name: 'Dmitri Laptev',
      url: siteOrigin,
      jobTitle:
        lang === 'de'
          ? 'Full-Stack Developer mit Fokus auf Frontend'
          : 'Full-Stack Developer with a Frontend Focus',
      description,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Freilassing',
        addressRegion: 'Bayern',
        addressCountry: 'DE',
      },
      sameAs: [
        'https://github.com/gerasem',
        'https://www.linkedin.com/in/dmitri-laptev',
      ],
      knowsLanguage: ['de', 'en', 'ru'],
      knowsAbout: [
        'Vue.js',
        'Nuxt',
        'React',
        'TypeScript',
        'Payload CMS',
        'Astro',
        'Svelte',
        'Tailwind CSS',
        'WordPress',
        'Laravel',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      url: siteOrigin,
      name: 'Dmitri Laptev — Portfolio',
      inLanguage: ['de', 'en'],
      author: { '@id': `${siteOrigin}/#person` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonicalUrl ?? siteOrigin}#webpage`,
      url: canonicalUrl ?? siteOrigin,
      name: title,
      inLanguage: lang,
      isPartOf: { '@id': `${siteOrigin}/#website` },
      mainEntity: { '@id': `${siteOrigin}/#person` },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={dmSansUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={plusJakartaUrl} crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={deUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-[#F6F8FC] text-[#1E293B] antialiased selection:bg-[#3B82F6]/15 selection:text-[#1E293B]">
    <slot />

    <script>
      // Scroll reveal observer
      const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && revealEls.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const delay = el.dataset.revealDelay;
                if (delay) {
                  el.style.transitionDelay = `${delay}ms`;
                }
                el.dataset.reveal = 'visible';
                observer.unobserve(el);
              }
            }
          },
          { threshold: 0.12 }
        );
        revealEls.forEach((el) => observer.observe(el));
      } else {
        revealEls.forEach((el) => {
          el.dataset.reveal = 'visible';
        });
      }

      // Copy email buttons
      document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const email = btn.dataset.copyEmail;
          if (!email) return;
          try {
            await navigator.clipboard.writeText(email);
            const defaultLabel = btn.querySelector<HTMLElement>('[data-copy-default]');
            const copiedLabel = btn.querySelector<HTMLElement>('[data-copy-success]');
            if (defaultLabel && copiedLabel) {
              defaultLabel.classList.add('hidden');
              copiedLabel.classList.remove('hidden');
              window.setTimeout(() => {
                defaultLabel.classList.remove('hidden');
                copiedLabel.classList.add('hidden');
              }, 2000);
            }
          } catch {
            // Clipboard write may be blocked in restricted contexts
          }
        });
      });
    </script>
  </body>
</html>
